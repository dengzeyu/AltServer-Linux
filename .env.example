# AltServer-Linux Docker Environment Configuration
# Copy this file to .env and modify the values as needed

# =============================================================================
# Anisette Server Configuration
# =============================================================================

# URL of the anisette server for Apple authentication
# Options:
# 1. Public servers (default)
# 2. Self-hosted server (recommended for privacy)
# 3. Local Docker container

# Option 1: Default public server
ANISETTE_SERVER=https://armconverter.com/anisette/irGb3Quww8zrhgqnzmrx

# Option 2: Alternative public servers (uncomment to use):
# ANISETTE_SERVER=https://anisette.nya.software
# ANISETTE_SERVER=https://api.anisette.org/v1

# Option 3: Self-hosted anisette server (uncomment to use)
# Pulls dadoum/anisette-v3-server:latest automatically from Docker Hub
# First start: docker-compose --profile anisette up -d
# Then use: ANISETTE_SERVER=http://anisette-server:8080
# ANISETTE_SERVER=http://anisette-server:8080

# Option 4: External anisette server (uncomment to use)
# ANISETTE_SERVER=http://your-anisette-server.com:8080

# =============================================================================
# Self-Hosted Anisette Server Configuration
# =============================================================================

# Debug level for anisette server (when using anisette profile)
# 0 = no debug, 1 = basic debug, 2 = verbose debug
ANISETTE_DEBUG=0

# Log level for anisette server (when using anisette profile)
# Options: debug, info, warn, error
ANISETTE_LOG_LEVEL=info

# Anisette server port (when using anisette profile)
# Default: 8080
ANISETTE_SERVER_PORT=8080

# =============================================================================
# AltServer Configuration
# =============================================================================

# Set to 1 if your usbmuxd server does not correctly handle interface subscriptions
# This is typically not needed for modern setups
# Default: 0
NO_SUBSCRIBE=0

# Debug logging level (0 = no debug, higher numbers = more verbose)
# Default: 0
# Use 1 for basic debug, 2 for verbose debug
DEBUG=0

# =============================================================================
# System Configuration
# =============================================================================

# Timezone for the container
# Default: UTC
# Examples: America/New_York, Europe/London, Asia/Tokyo
TZ=UTC

# =============================================================================
# Docker Compose Configuration
# =============================================================================

# Portainer stack name (for labeling and organization)
# This will be automatically set by Portainer when deploying as a stack
PORTAINER_STACK_NAME=altserver

# =============================================================================
# Network Configuration
# =============================================================================

# Custom network subnet for AltServer services
# Only used if not using host networking
# Default: 172.20.0.0/16
# ALTSERVER_SUBNET=172.20.0.0/16

# =============================================================================
# Volume Configuration
# =============================================================================

# Local paths for data and logs (relative to docker-compose.yml)
# These will be mounted as Docker volumes
# Default: ./data and ./logs (relative paths)
# DATA_PATH=./data
# LOGS_PATH=./logs

# =============================================================================
# Resource Limits
# =============================================================================

# Maximum memory for AltServer container (in MB)
# Default: 512
# ALTSERVER_MEMORY_LIMIT=512

# Maximum CPU cores for AltServer container (as decimal)
# Default: 1.0
# ALTSERVER_CPU_LIMIT=1.0

# Reserved memory for AltServer container (in MB)
# Default: 256
# ALTSERVER_MEMORY_RESERVATION=256

# Reserved CPU cores for AltServer container (as decimal)
# Default: 0.5
# ALTSERVER_CPU_RESERVATION=0.5

# =============================================================================
# Health Check Configuration
# =============================================================================

# Health check interval in seconds
# Default: 30
# HEALTH_CHECK_INTERVAL=30

# Health check timeout in seconds
# Default: 10
# HEALTH_CHECK_TIMEOUT=10

# Health check retry count
# Default: 3
# HEALTH_CHECK_RETRIES=3

# Health check start period in seconds
# Default: 10
# HEALTH_CHECK_START_PERIOD=10

# =============================================================================
# Logging Configuration
# =============================================================================

# Maximum log file size before rotation
# Default: 10m (10 megabytes)
# LOG_MAX_SIZE=10m

# Maximum number of log files to retain
# Default: 5
# LOG_MAX_FILES=5

# =============================================================================
# Advanced Configuration
# =============================================================================

# Container user ID (uncomment to run as specific user instead of default 1000)
# CONTAINER_UID=1000

# Container group ID (uncomment to run as specific group instead of default 1000)
# CONTAINER_GID=1000

# Custom DNS servers (comma-separated)
# Default: system DNS
# CUSTOM_DNS_SERVERS=8.8.8.8,8.8.4.4

# HTTP proxy for outgoing connections (if needed)
# HTTP_PROXY=

# HTTPS proxy for outgoing connections (if needed)
# HTTPS_PROXY=

# =============================================================================
# Development and Testing
# =============================================================================

# Enable development mode with additional tools
# Default: not set (production mode)
# DEVELOPMENT_MODE=1

# Skip network connectivity tests during startup
# Default: not set (tests are enabled)
# SKIP_CONNECTIVITY_TEST=1